# ── LLM / Anthropic ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# Global model override (applies to every role unless a per-role override is set).
# Precedence: per-role *_MODEL -> COBOL_MOD_LLM_MODEL -> hardcoded tier default.
COBOL_MOD_LLM_MODEL=

# Per-role model overrides (see cobol_modernizer/cost/tiering.py). Defaults:
#   enrichment/ask/equivalence_triage -> claude-haiku-4-5-20251001
#   brd/seam/story/codegen            -> claude-sonnet-4-6
#   judge/design/repair/advisor       -> claude-opus-4-8
ENRICHMENT_MODEL=
ASK_MODEL=
EQUIV_TRIAGE_MODEL=
BRD_AGENT_MODEL=
SEAM_MODEL=
STORY_MODEL=
CODEGEN_MODEL=
JUDGE_MODEL=
DESIGN_MODEL=
REPAIR_MODEL=
ADVISOR_MODEL=

# Budgeted Opus advisor escalation (off-by-default budget).
ADVISOR_MAX_USES=3

# Prompt caching: request 1h TTL cache for batch runs (0=off, 1=on).
COBOL_MOD_PROMPT_CACHING_1H=0

# ── Cost caps + kill-switch ───────────────────────────────────────────────────
COBOL_MOD_WORKSPACE_CAP_USD=50.0
COBOL_MOD_RUN_CAP_USD=5.0

# ── Neo4j (code graph ONLY) ───────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# ── Postgres (run/audit/version/RBAC state ONLY) ──────────────────────────────
POSTGRES_URL=postgresql+psycopg://cobol:cobol@localhost:5432/cobol_modernizer

# ── MinIO object store (snapshots, slices, generated projects, golden files) ──
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── COBOL extractor (ProLeap JAR) ─────────────────────────────────────────────
COBOL_EXTRACTOR_JAR=tools/cobol-extractor/target/cobol-extractor.jar
